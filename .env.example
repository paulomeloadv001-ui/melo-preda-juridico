# ============================================================
# MELO ADVOGADOS - JUSCONSIG
# Variáveis de Ambiente para Integrações
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais

# ==================== BANCO DE DADOS ====================
DATABASE_URL=mysql://usuario:senha@host:3306/melo_advogados

# ==================== OPENAI (AGENTE IA) ====================
OPENAI_API_KEY=sk-...
# Modelo padrão: gpt-4o-mini (pode usar gpt-4o para análises profundas)

# ==================== CLOUDFLARE ====================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# R2 Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=melo-advogados-storage
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# ==================== DATAJUD (CNJ) ====================
# Obter em: https://datajud-wiki.cnj.jus.br/api-publica/
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
# Chave pública de demonstração acima — solicitar chave própria no CNJ

# ==================== CELCOIN (MARGEM CONSIGNÁVEL) ====================
# Obter em: https://developers.celcoin.com.br
CELCOIN_CLIENT_ID=
CELCOIN_CLIENT_SECRET=
CELCOIN_ENVIRONMENT=sandbox
# Valores: sandbox | production

# ==================== NEOCONSIG ====================
# Portal de gestão de consignações do Estado de Goiás
NEOCONSIG_API_URL=https://api.neoconsig.com.br/v1
NEOCONSIG_TOKEN=
NEOCONSIG_WEBHOOK_SECRET=

# ==================== GMAIL / PROJUDI ====================
# OAuth2 para importação automática de publicações
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=paulo40559jus@gmail.com
# Filtro de remetentes PROJUDI
GMAIL_PROJUDI_REMETENTES=projudi@tjgo.jus.br,intimacao@projudi.tjgo.jus.br

# ==================== OPEN FINANCE / BANCO DO BRASIL ====================
# API de Alvarás e Operações Financeiras
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_DEVELOPER_KEY=
BB_ENVIRONMENT=sandbox
# Valores: sandbox | production

# ==================== DADOS ABERTOS GO ====================
# Não requer credencial — acesso público via CSV
# URL base: https://dadosabertos.go.gov.br/dataset/folha-de-pagamento
DADOS_ABERTOS_GO_URL=https://dadosabertos.go.gov.br

# ==================== GOIASPREV ====================
# Previdência estadual de Goiás
GOIASPREV_API_URL=https://api.goiasprev.go.gov.br
GOIASPREV_TOKEN=

# ==================== WEBHOOKS ====================
# Secret para validação de webhooks recebidos
WEBHOOK_SECRET=gerar-uma-chave-segura-aqui
# URL pública do sistema (para registrar webhooks em sistemas externos)
WEBHOOK_BASE_URL=https://seu-dominio.com/api/webhooks

# ==================== SENTRY (MONITORAMENTO) ====================
SENTRY_DSN=

# ==================== CONFIGURAÇÕES DO SISTEMA ====================
# Ambiente
NODE_ENV=production
# Porta do servidor
PORT=5000
# Sessão
SESSION_SECRET=gerar-uma-chave-segura-aqui
# Domínio
APP_DOMAIN=https://seu-dominio.com

# ==================== CRON JOBS ====================
# Ativar/desativar cron jobs automáticos
CRON_ENABLED=true
# Horários (formato cron)
CRON_FOLHA_GO=0 8 10 * *
CRON_MOVIMENTACOES=0 6 * * *
CRON_PRAZOS=0 7 * * *
CRON_MARGEM=0 8 * * 1
